{
  "name": "@openbooking/google-calendar",
  "version": "0.1.0",
  "description": "Google Calendar sync for OpenBooking: busy times block availability, bookings appear as events.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@openbooking/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openbooking/core": "workspace:^",
    "@openbooking/provider-memory": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
