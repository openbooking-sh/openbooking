{
  "name": "@openbooking/postgres",
  "version": "0.1.0",
  "description": "Postgres storage for OpenBooking: bookings and holds, idempotency, Studio activity and connector records.",
  "license": "Apache-2.0",
  "homepage": "https://openbooking.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbooking-sh/openbooking.git",
    "directory": "packages/postgres"
  },
  "bugs": {
    "url": "https://github.com/openbooking-sh/openbooking/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@openbooking/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openbooking/core": "workspace:^",
    "@openbooking/provider-memory": "workspace:^",
    "@openbooking/studio": "workspace:^",
    "pg": "^8.23.1",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "@openbooking/provider-calcom": "workspace:^",
    "@openbooking/hosted": "workspace:^",
    "@openbooking/google-calendar": "workspace:^",
    "@openbooking/notifications": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@openbooking/provider-calcom": {
      "optional": true
    },
    "@openbooking/hosted": {
      "optional": true
    },
    "@openbooking/google-calendar": {
      "optional": true
    },
    "@openbooking/notifications": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@openbooking/provider-calcom": "workspace:^",
    "@openbooking/hosted": "workspace:^",
    "@openbooking/google-calendar": "workspace:^",
    "@openbooking/notifications": "workspace:^"
  }
}
