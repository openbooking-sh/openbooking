{
  "name": "@openbooking-sh/payments-stripe",
  "version": "0.13.0",
  "description": "Stripe deposits for OpenBooking: a Checkout page for the deposit, verified before a booking is confirmed, and refunds that follow the cancellation terms.",
  "license": "Apache-2.0",
  "homepage": "https://openbooking.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbooking-sh/openbooking.git",
    "directory": "packages/payments-stripe"
  },
  "bugs": {
    "url": "https://github.com/openbooking-sh/openbooking/issues"
  },
  "keywords": [
    "openbooking",
    "booking",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "stripe",
    "deposits",
    "payments"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@openbooking/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openbooking-sh/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
