{
  "name": "@openbooking-sh/conformance",
  "version": "0.9.0",
  "description": "Conformance test suite for OpenBooking BookingProviders: proves a booking system never double-books, expires holds and reports errors correctly.",
  "license": "Apache-2.0",
  "homepage": "https://openbooking.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbooking-sh/openbooking.git",
    "directory": "packages/conformance"
  },
  "bugs": {
    "url": "https://github.com/openbooking-sh/openbooking/issues"
  },
  "keywords": [
    "openbooking",
    "booking",
    "conformance",
    "testing",
    "vitest",
    "ai-agents",
    "mcp"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@openbooking/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "@openbooking/source": "./src/vitest.ts",
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openbooking-sh/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "devDependencies": {
    "@openbooking-sh/provider-memory": "workspace:^"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
