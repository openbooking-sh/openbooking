{
  "name": "@openbooking-sh/hosted",
  "version": "0.7.0",
  "description": "Hosted multi-business OpenBooking: sign-up, Studio settings, one MCP app across all businesses.",
  "license": "Apache-2.0",
  "homepage": "https://openbooking.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbooking-sh/openbooking.git",
    "directory": "packages/hosted"
  },
  "bugs": {
    "url": "https://github.com/openbooking-sh/openbooking/issues"
  },
  "keywords": [
    "openbooking",
    "booking",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "appointments",
    "scheduling",
    "saas",
    "multi-tenant"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@openbooking/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/hono": "^2.0.1",
    "@modelcontextprotocol/server": "^2.2.0",
    "@openbooking-sh/adapter-mcp": "workspace:^",
    "@openbooking-sh/booking-page": "workspace:^",
    "@openbooking-sh/core": "workspace:^",
    "@openbooking-sh/google-calendar": "workspace:^",
    "@openbooking-sh/notifications": "workspace:^",
    "@openbooking-sh/provider-memory": "workspace:^",
    "@openbooking-sh/server": "workspace:^",
    "@openbooking-sh/studio": "workspace:^",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
