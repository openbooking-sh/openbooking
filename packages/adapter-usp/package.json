{
  "name": "@openbooking-sh/adapter-usp",
  "version": "0.0.0",
  "description": "Universal Scheduling Protocol (USP) profile, catalog, availability and booking endpoints for OpenBooking.",
  "license": "Apache-2.0",
  "homepage": "https://openbooking.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbooking-sh/openbooking.git",
    "directory": "packages/adapter-usp"
  },
  "bugs": {
    "url": "https://github.com/openbooking-sh/openbooking/issues"
  },
  "keywords": [
    "openbooking",
    "booking",
    "ai-agents",
    "appointments",
    "scheduling",
    "usp",
    "universal-scheduling-protocol"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@openbooking/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "@openbooking-sh/core": "workspace:^",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/client": "^2.2.0",
    "@openbooking-sh/booking-page": "workspace:^",
    "@openbooking-sh/provider-memory": "workspace:^",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
