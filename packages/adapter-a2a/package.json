{
  "name": "@openbooking-sh/adapter-a2a",
  "version": "0.9.0",
  "description": "A2A (Agent2Agent) Agent Card generation for OpenBooking. SendMessage endpoint routing to the same booking engine as MCP and UCP.",
  "license": "Apache-2.0",
  "homepage": "https://openbooking.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbooking-sh/openbooking.git",
    "directory": "packages/adapter-a2a"
  },
  "bugs": {
    "url": "https://github.com/openbooking-sh/openbooking/issues"
  },
  "keywords": [
    "openbooking",
    "booking",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "appointments",
    "scheduling",
    "a2a",
    "agent2agent"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@openbooking/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openbooking-sh/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@openbooking-sh/provider-memory": "workspace:^"
  }
}
