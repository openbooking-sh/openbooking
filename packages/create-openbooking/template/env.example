# Copy to .env (or set in your host's dashboard).
# Public URL of this backend, e.g. https://book.example.com (defaults to localhost).
BASE_URL=
# Required anywhere but your own machine: protects Studio, which shows customer details.
# Without it, Studio stays locked on a host.
STUDIO_TOKEN=
# Optional: keep bookings in Postgres (e.g. Neon). Without it bookings live in memory.
DATABASE_URL=
