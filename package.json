{
  "name": "openbooking",
  "private": true,
  "description": "Make any booking system bookable by AI agents through one integration (MCP, UCP, A2A).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @openbooking/example-demo dev",
    "start": "pnpm --filter @openbooking/example-demo start",
    "dev:hosted": "pnpm --filter @openbooking/example-demo dev:hosted",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "pnpm --filter @openbooking/bench bench",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@openbooking/hosted": "workspace:^",
    "@openbooking/notifications": "workspace:^",
    "@openbooking/postgres": "workspace:^",
    "@openbooking/provider-memory": "workspace:^",
    "@openbooking/server": "workspace:^",
    "@sentry/node": "^11.4.0",
    "@vercel/functions": "^3.9.11"
  }
}
