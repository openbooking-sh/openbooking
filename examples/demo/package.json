{
  "name": "@openbooking-sh/example-demo",
  "version": "0.0.0",
  "private": true,
  "description": "OpenBooking demo: a fictional hair salon (or restaurant) bookable by AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@openbooking/source src/index.ts",
    "start": "tsx --conditions=@openbooking/source src/index.ts",
    "stdio": "tsx --conditions=@openbooking/source src/stdio.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:hosted": "tsx watch --conditions=@openbooking/source src/hosted.ts",
    "start:hosted": "tsx --conditions=@openbooking/source src/hosted.ts"
  },
  "dependencies": {
    "@openbooking-sh/adapter-mcp": "workspace:^",
    "@openbooking-sh/core": "workspace:^",
    "@openbooking-sh/postgres": "workspace:^",
    "@openbooking-sh/provider-calcom": "workspace:^",
    "@openbooking-sh/provider-memory": "workspace:^",
    "@openbooking-sh/server": "workspace:^",
    "@openbooking-sh/hosted": "workspace:^",
    "@openbooking-sh/notifications": "workspace:^"
  }
}
